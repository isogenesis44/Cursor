# WHISPER_MODEL_OPENAI=openai/whisper
# DATA_DIR=./data
# RENDER_CONCURRENCY=4
# RENDER_CRF=18
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell   # otherwise Remotion downloads its own
